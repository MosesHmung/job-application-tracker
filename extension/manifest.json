{
  "manifest_version": 3,
  "name": "Job Application Tracker",
  "version": "1.0.0",
  "description": "Save job postings directly to your Job Application Tracker.",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Application Tracker"
  },

  "permissions": [
    "activeTab"
  ],

  "host_permissions": [
    "http://localhost:8080/*"
  ]
}